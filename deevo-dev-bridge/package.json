{
  "name": "@deevo/dev-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP development bridge for controlled workspace, terminal, npm, Git and Docker access.",
  "license": "MIT",
  "engines": {"node": ">=20"},
  "scripts": {
    "dev": "tsx src/index.ts --stdio",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js --stdio",
    "http": "tsx src/index.ts --http"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "latest",
    "@modelcontextprotocol/server": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
